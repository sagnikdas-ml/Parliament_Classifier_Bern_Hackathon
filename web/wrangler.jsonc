{
  "name": "parlaradar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "vars": {"BACKEND_URL": "", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": ""},
  "ratelimits": [{"name": "API_LIMITER", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}}],
  "env": {
    "local": {
      "vars": {"BACKEND_URL": "http://127.0.0.1:8000", "LOCAL_DEMO": "true", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": ""},
      "ratelimits": [{"name": "API_LIMITER", "namespace_id": "1002", "simple": {"limit": 90, "period": 60}}]
    }
  }
}
